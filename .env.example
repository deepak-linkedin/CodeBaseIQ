# Copy to .env for local development. Never commit your real .env.
APP_NAME=CodebaseIQ
DEBUG=false
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
DATA_DIR=./data
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Configure both values to enable Google authentication.
# DATABASE_URL can be a Supabase/PostgreSQL connection string.
GOOGLE_CLIENT_ID=
AUTH_REQUIRED=false
DATABASE_URL=
